<Project Sdk="Microsoft.NET.Sdk">

  <!-- Writes the public API of built assemblies as sorted text, so a change to the surface shows in review: api/*.txt. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OneIndex.ApiListing</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

</Project>
