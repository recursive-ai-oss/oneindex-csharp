<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OneIndex.Cli.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051;xUnit1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests run the packed tool; the references let them open what the tool built. -->
    <ProjectReference Include="../../src/OneIndex.Files/OneIndex.Files.csproj" />
    <ProjectReference Include="../../src/OneIndex.Cli/OneIndex.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
