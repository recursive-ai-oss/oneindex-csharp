<Project Sdk="Microsoft.NET.Sdk">

  <!-- The durability harness: fault-injection sweeps over the index writer and the kill campaign (a writer child process that is
       killed at random points). It is a plain console program so that the child can be started with the same binary. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OneIndex.Durability</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneIndex/OneIndex.csproj" />
  </ItemGroup>

</Project>
