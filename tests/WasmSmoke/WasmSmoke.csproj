<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OneIndex.WasmSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <WasmMainJSPath>main.mjs</WasmMainJSPath>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <WasmExtraFilesToDeploy Include="main.mjs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../AotSmoke/SmokeScenario.cs" Link="SmokeScenario.cs" />
    <Compile Include="../AotSmoke/AnalysisScenario.cs" Link="AnalysisScenario.cs" />
    <Compile Include="../AotSmoke/QueryFormsLowLevelScenario.cs" Link="QueryFormsLowLevelScenario.cs" />
    <Compile Include="../AotSmoke/VectorScenario.cs" Link="VectorScenario.cs" />
    <Compile Include="../AotSmoke/RankingScenario.cs" Link="RankingScenario.cs" />
    <Compile Include="../AotSmoke/AsianScenario.cs" Link="AsianScenario.cs" />
    <Compile Include="../AotSmoke/StaticScenario.cs" Link="StaticScenario.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneIndex.Generators/OneIndex.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <ProjectReference Include="../../src/OneIndex/OneIndex.csproj" />
    <ProjectReference Include="../../src/OneIndex.Models/OneIndex.Models.csproj" />
    <ProjectReference Include="../../src/OneIndex.Analysis.Asian/OneIndex.Analysis.Asian.csproj" />
  </ItemGroup>

</Project>
