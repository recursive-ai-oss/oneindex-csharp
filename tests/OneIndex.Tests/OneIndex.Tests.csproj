<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OneIndex.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051;xUnit1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fuzz target's reader exerciser doubles as a corruption test here. -->
    <Compile Include="../../fuzz/OneIndex.Fuzz/TextIndexTarget.cs" Link="Fuzz/TextIndexTarget.cs" />
    <Compile Include="../../fuzz/OneIndex.Fuzz/QueryTarget.cs" Link="Fuzz/QueryTarget.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneIndex/OneIndex.csproj" />
    <!-- The test codec and the seeded workload of the durability harness are shared with these tests. -->
    <ProjectReference Include="../Durability/Durability.csproj" />
    <!-- The generator runs over this project's own attributed test types. -->
    <ProjectReference Include="../../src/OneIndex.Generators/OneIndex.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>

</Project>
