<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OneIndex.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051;xUnit1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fuzz target's reader exerciser doubles as a corruption test here. -->
    <Compile Include="../../fuzz/OneIndex.Fuzz/TextIndexTarget.cs" Link="Fuzz/TextIndexTarget.cs" />
    <Compile Include="../../fuzz/OneIndex.Fuzz/QueryTarget.cs" Link="Fuzz/QueryTarget.cs" />
    <Compile Include="../../fuzz/OneIndex.Fuzz/DocValuesFixture.cs" Link="Fuzz/DocValuesFixture.cs" />
    <Compile Include="../../fuzz/OneIndex.Fuzz/DocValuesTarget.cs" Link="Fuzz/DocValuesTarget.cs" />
    <Compile Include="../../fuzz/OneIndex.Fuzz/VectorTarget.cs" Link="Fuzz/VectorTarget.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The black-box JSON Schema validator script used by the SearchTool tests when a Python with the jsonschema wheel is configured. -->
    <Content Include="../../tools/jsonschema_check.py" Link="jsonschema_check.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- The generator tests run the generator over small compilations. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneIndex/OneIndex.csproj" />
    <ProjectReference Include="../../src/OneIndex.Models/OneIndex.Models.csproj" />
    <!-- The test codec and the seeded workload of the durability harness are shared with these tests. -->
    <ProjectReference Include="../Durability/Durability.csproj" />
    <!-- The generator runs over this project's own attributed test types. -->
    <ProjectReference Include="../../src/OneIndex.Generators/OneIndex.Generators.csproj" OutputItemType="Analyzer" />
  </ItemGroup>

</Project>
