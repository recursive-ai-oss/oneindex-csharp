<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OneIndex.VectorData</RootNamespace>
    <PackageId>$(PackagePrefix).VectorData</PackageId>
    <Description>A vector store collection over OneIndex for Microsoft.Extensions.VectorData. Part of the OneIndex embedded search engine; unaffiliated with other products named OneIndex, OneSearch or similar.</Description>
    <!-- Records are mapped by reflection, as the abstraction itself does; the types say so with RequiresUnreferencedCode. -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OneIndex/OneIndex.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" />
  </ItemGroup>

</Project>
