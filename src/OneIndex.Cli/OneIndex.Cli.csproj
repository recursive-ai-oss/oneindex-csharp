<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OneIndex.Cli</RootNamespace>
    <PackageId>$(PackagePrefix).Cli</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>oneindex</ToolCommandName>
    <Description>The oneindex command-line tool for the OneIndex embedded search engine: index a folder, query it, build a static index. Unaffiliated with other products named OneIndex, OneSearch or similar.</Description>
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OneIndex/OneIndex.csproj" />
    <ProjectReference Include="../OneIndex.Models/OneIndex.Models.csproj" />
    <ProjectReference Include="../OneIndex.Analysis.Asian/OneIndex.Analysis.Asian.csproj" />
    <ProjectReference Include="../OneIndex.Files/OneIndex.Files.csproj" />
    <ProjectReference Include="../OneIndex.Files.Ocr/OneIndex.Files.Ocr.csproj" />
  </ItemGroup>

</Project>
