<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OneIndex.Models</RootNamespace>
    <PackageId>$(PackagePrefix).Models</PackageId>
    <Description>Embedders for the OneIndex embedded search engine: a WordPiece tokenizer and the default English dense embedder (bge-small-en-v1.5, MIT licence, weights included), running on OneModel. Unaffiliated with other products named OneIndex, OneSearch or similar.</Description>
  </PropertyGroup>

  <PropertyGroup Label="Packed weights">
    <!-- Written by tools/models/pack-weights.sh (it converts the published model once and copies the result here). A build without them
         compiles and runs, but BgeSmallEmbedder.Load() then reports that the weights are missing. -->
    <OneIndexModelWeights Condition="'$(OneIndexModelWeights)' == ''">$(ArtifactsPath)/model-weights/bge-small-en-v1.5</OneIndexModelWeights>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(OneIndexModelWeights)/model.onemodel') And Exists('$(OneIndexModelWeights)/vocab.txt')">
    <EmbeddedResource Include="$(OneIndexModelWeights)/model.onemodel" LogicalName="OneIndex.Models.Weights.bge-small-en-v1.5.onemodel" />
    <EmbeddedResource Include="$(OneIndexModelWeights)/vocab.txt" LogicalName="OneIndex.Models.Weights.bge-small-en-v1.5.vocab.txt" />
    <None Include="$(OneIndexModelWeights)/LICENSE-bge-small-en-v1.5.txt" Pack="true" PackagePath="models/bge-small-en-v1.5/" Visible="false" />
  </ItemGroup>

  <PropertyGroup Label="Packed sparse weights">
    <!-- Written by tools/models/pack-sparse-weights.sh. A build without them compiles; OpenSearchSparseEncoder.Load() then reports that they are missing. -->
    <OneIndexSparseWeights Condition="'$(OneIndexSparseWeights)' == ''">$(ArtifactsPath)/model-weights/neural-sparse</OneIndexSparseWeights>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(OneIndexSparseWeights)/model.onemodel') And Exists('$(OneIndexSparseWeights)/vocab.txt') And Exists('$(OneIndexSparseWeights)/idf.json')">
    <EmbeddedResource Include="$(OneIndexSparseWeights)/model.onemodel" LogicalName="OneIndex.Models.Weights.neural-sparse.onemodel" />
    <EmbeddedResource Include="$(OneIndexSparseWeights)/vocab.txt" LogicalName="OneIndex.Models.Weights.neural-sparse.vocab.txt" />
    <EmbeddedResource Include="$(OneIndexSparseWeights)/idf.json" LogicalName="OneIndex.Models.Weights.neural-sparse.idf.json" />
    <None Include="$(OneIndexSparseWeights)/LICENSE-neural-sparse.txt" Pack="true" PackagePath="models/neural-sparse/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OneIndex/OneIndex.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RecursiveAI.OneModel" />
  </ItemGroup>

</Project>
