<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runnable samples: the happy path (a directory index of attributed documents) and Entity Framework Core. The same code runs as tests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OneIndex.Samples</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneIndex/OneIndex.csproj" />
    <ProjectReference Include="../../src/OneIndex.EntityFrameworkCore/OneIndex.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../../src/OneIndex.Generators/OneIndex.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
  </ItemGroup>

</Project>
