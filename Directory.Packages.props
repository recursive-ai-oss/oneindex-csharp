<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Shipped dependencies (adapter packages only)">
    <PackageVersion Include="RecursiveAI.OneModel" Version="1.0.0" />
    <PackageVersion Include="RecursiveAI.OnePdf" Version="1.15.1" />
    <PackageVersion Include="RecursiveAI.OneHtml" Version="1.5.1" />
    <PackageVersion Include="RecursiveAI.OneArchive" Version="1.0.0" />
    <PackageVersion Include="RecursiveAI.OneOcr" Version="1.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.VectorData.Abstractions" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Label="Build time only">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>
  <ItemGroup Label="Tests, benchmarks and fuzz targets only">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="SharpFuzz" Version="2.2.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <!-- The SQLite provider brings 2.1.11 of the native library, which has a published advisory; take the patched release. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
  </ItemGroup>
  <ItemGroup Label="Comparators (tools, tests and benchmarks only; black-box, pinned releases)">
    <PackageVersion Include="Hnsw.Net" Version="0.1.4" />
    <PackageVersion Include="HNSW" Version="26.9.5494" />
    <!-- The HNSW package pulls in MessagePack 3.1.0, which has published advisories; the benchmark project takes the patched release instead. -->
    <PackageVersion Include="MessagePack" Version="3.1.12" />
    <PackageVersion Include="Lucene.Net" Version="4.8.0-beta00018" />
    <PackageVersion Include="Lucene.Net.Analysis.Common" Version="4.8.0-beta00018" />
    <PackageVersion Include="Lucene.Net.Facet" Version="4.8.0-beta00018" />
  </ItemGroup>
</Project>
