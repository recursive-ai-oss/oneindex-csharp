<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Shipped dependencies (adapter packages only)">
    <PackageVersion Include="RecursiveAI.OneModel" Version="1.0.0" />
    <PackageVersion Include="RecursiveAI.OnePdf" Version="1.15.1" />
    <PackageVersion Include="RecursiveAI.OneHtml" Version="1.5.1" />
    <PackageVersion Include="RecursiveAI.OneArchive" Version="1.0.0" />
    <PackageVersion Include="RecursiveAI.OneOcr" Version="1.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.VectorData.Abstractions" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Label="Build time only">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>
  <ItemGroup Label="Tests, benchmarks and fuzz targets only">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="SharpFuzz" Version="2.2.0" />
  </ItemGroup>
</Project>
