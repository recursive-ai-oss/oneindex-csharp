<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OneIndex.Fuzz</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The target runs under libFuzzer with SharpFuzz coverage instrumentation, not as a trimmed app. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpFuzz" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneIndex/OneIndex.csproj" />
  </ItemGroup>

</Project>
